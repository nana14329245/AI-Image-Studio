# Server-only fal.ai credential. Never prefix this value with NEXT_PUBLIC_.
FAL_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Public site address, used for Open Graph images, the sitemap and robots.txt.
# Leave empty locally; robots.txt blocks all crawling until this is set.
NEXT_PUBLIC_SITE_URL=

# Optional product analytics (PostHog). Nothing is sent while the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional error monitoring (Sentry). Nothing is sent while the DSN is empty.
# A DSN is a write-only, non-secret endpoint, not a credential — see
# https://docs.sentry.io/product/sentry-basics/dsn-explainer/
NEXT_PUBLIC_SENTRY_DSN=

# Optional CAPTCHA on signup (Cloudflare Turnstile), so a script can't farm
# free signup credits with disposable accounts. No widget renders and
# signup works unchanged while this is empty. Get the Sitekey from
# https://dash.cloudflare.com (Turnstile), then also paste the matching
# Secret key into Supabase → Authentication → Attack Protection → Enable
# CAPTCHA protection — Supabase Auth verifies the token, this app never sees
# the secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shown on /terms, /privacy, /refund and /contact. The pages display a visible
# placeholder until both are set — set them before taking real payments.
NEXT_PUBLIC_LEGAL_SELLER_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Optional: a dedicated test account for the signed-in Playwright tests
# (npm run test:e2e). Create it through the normal signup; never use a real
# customer's account. The tests mock generation and billing, so nothing is spent.
E2E_EMAIL=
E2E_PASSWORD=
