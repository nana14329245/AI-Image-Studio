# Server-only fal.ai credential. Never prefix this value with NEXT_PUBLIC_.
FAL_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Public site address, used for Open Graph images, the sitemap and robots.txt.
# Leave empty locally; robots.txt blocks all crawling until this is set.
NEXT_PUBLIC_SITE_URL=

# Optional product analytics (PostHog). Nothing is sent while the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
